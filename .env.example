# The settings the forge package reads for a local run against Forgejo; the
# backend reads none itself. Copy it to .env, fill in the empty values and
# start. A variable that is set must not be empty, so the optional ones below
# are commented out and take the default their comment gives until you
# uncomment them. `deploy`'s bootstrap writes the stack's own values; this
# copy is for running the backend on its own, against the development stack's
# Forgejo, CI and Garage at their published ports.
#
# Two settings are left to forge's defaults here, as in `deploy`: UNICON_FORGE
# is forgejo unless set (fake runs the whole shell against the in-memory forge,
# with no git host, Garage or CI), and UNICON_COOKIE_SECURE follows
# UNICON_PUBLIC_URL, off for the http address below.

UNICON_PUBLIC_URL=http://localhost:8080
UNICON_DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5440/unicon

# Where the forge reaches the platform: the org event push is aimed here.
# UNICON_PUBLIC_URL unless set.
# UNICON_INTERNAL_URL=http://localhost:8080
# Where a grading machine reaches the platform: the envelope, the callback and
# the log upload. UNICON_PUBLIC_URL unless set.
# UNICON_MACHINE_URL=http://localhost:8080

UNICON_FORGE_PUBLIC_URL=http://localhost:3300
# Where the package reaches Forgejo. UNICON_FORGE_PUBLIC_URL unless set.
# UNICON_FORGE_INTERNAL_URL=http://localhost:3300
UNICON_FORGE_ADMIN_TOKEN=
# The Forgejo account the admin token belongs to, the one account protected
# tags are reserved for.
UNICON_FORGE_PLATFORM_ACCOUNT=unicon-backend
# Forgejo OAuth application, redirect {UNICON_PUBLIC_URL}/api/v1/auth/callback
UNICON_FORGE_OAUTH_CLIENT_ID=
UNICON_FORGE_OAUTH_CLIENT_SECRET=

# Whether the forge takes new sign-ups, which decides whether the landing page
# offers Create account. Off unless the instance says otherwise.
UNICON_FORGE_REGISTRATION_OPEN=false

# Whether any signed-in person may create an org; otherwise only the operator,
# with `unicon create-org`. On unless set.
UNICON_ORG_CREATION_OPEN=true

UNICON_WOODPECKER_URL=http://localhost:8000
# The URL the CI knows itself by, which it writes its webhooks under.
# UNICON_WOODPECKER_URL unless set.
# UNICON_WOODPECKER_PUBLIC_URL=http://localhost:8000
UNICON_WOODPECKER_TOKEN=

# The object store: uploads before a submit and the grading logs, both through
# presigned URLs. Required with UNICON_FORGE=forgejo. The key is the one
# bootstrap writes to deploy/.env as UNICON_S3_ACCESS_KEY and
# UNICON_S3_SECRET_KEY.
UNICON_S3_ENDPOINT=http://localhost:3900
UNICON_S3_ACCESS_KEY=
UNICON_S3_SECRET_KEY=
# These two are the defaults.
UNICON_S3_REGION=garage
UNICON_S3_RESULTS_BUCKET=unicon-results

# 32 random bytes each, base64url: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
UNICON_SESSION_SIGNING_KEY=
UNICON_TOKEN_ENCRYPTION_KEY=

# The level for `unicon api`, read by forge's logger. Every line is one JSON
# record; nothing logs a token or a code at any level.
UNICON_LOG_LEVEL=INFO

# Seconds. The hard session lifetime matches the forge's refresh-token lifetime.
UNICON_SESSION_HARD_TTL=2592000
UNICON_SESSION_IDLE_TTL=1209600
UNICON_SIGN_IN_TTL=600
UNICON_FRESH_SIGN_IN_WINDOW=300

# Whether the per-read cache around the forge port is on. The two reads that
# grow with the forge are cached either way.
UNICON_FORGE_CACHE=false

# The harness every plan runs and the image the CI checks a task and a
# submission out with, each by digest. The ones of the runner release forge
# pins unless set.
# UNICON_HARNESS_IMAGE=ghcr.io/uniconhq/harness@sha256:...
# UNICON_CLONE_IMAGE=ghcr.io/uniconhq/clone@sha256:...
